# PostgreSQL connection string. For local development with docker-compose.yml:
DATABASE_URL="postgresql://ticketbooking:ticketbooking@localhost:55432/ticketbooking"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Resend API key for transactional email. Leave empty in development to log emails to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="Ticket Booking <tickets@example.com>"

# Public base URL of the app, used in emails and QR payload links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
